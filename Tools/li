            print("%d  %s" % (i, p["name"] or "(unnamed)"))
        return
    modes = [MODE_ALIASES.get(m.strip(), m.strip()) for m in args.get("--mode", "spacing").split(",") if m.strip()]
    for m in modes:
        if m not in MODES:
            raise Fail("unknown mode %s" % m)
    size = args.get("--size")
    if args.get("--view"):
        body, label, params = args.get("--view"), "view", ""
    else:
        if args.get("--preview") is not None:
            name = args.get("--preview")
            hits = [p for p in previews if p["name"] == name] or [p for p in previews if p["name"].startswith(name)]
            if len(hits) != 1:
                raise Fail("preview %r: %d matches; li preview FILE --list" % (name, len(hits)))
            chosen = hits[0]
        elif args.get("--index") is not None:
            i = int(args.get("--index"))
            if not 0 <= i < len(previews):
                raise Fail("--index %d: the file has %d previews; li preview FILE --list" % (i, len(previews)))
            chosen = previews[i]
        else:
            raise Fail("which preview? --preview NAME, --index N or --view EXPR")
        body, label, params = chosen["body"], chosen["name"] or "preview", chosen["params"]
        if "@Previewable" in body:
            raise Fail("previews with @Previewable state can't run as a snippet; pass the view with --view")
    if not size and "sizeThatFitsLayout" in params:
        size = "fit"
    w, h, fit = 402, 874, False
    if size == "fit":
        fit = True
    elif size:
        parts = size.lower().split("x")
        if len(parts) != 2:
            raise Fail("--size WIDTHxHEIGHT (e.g. 402x874) or fit")
        w, h = int(parts[0]), int(parts[1])
    slug = re.sub(r"[^A-Za-z0-9]+", "-", "%s-%s" % (os.path.splitext(os.path.basename(path))[0], label)).strip("-")
    out = os.path.abspath(args.get("--out") or os.path.join(tempfile.gettempdir(), "layout-inspector", "previews",
                                                         time.strftime("%Y%m%d-%H%M%S-") + slug))
    os.makedirs(out, exist_ok=True)
    code = (SNIPPET.replace("__W__", str(w)).replace("__H__", str(h)).replace("__FIT__", "true" if fit else "false")
            .replace("__STABLE__", str(float(args.get("--stable-timeout", "15"))))
            .replace("__OUT__", out.replace("\\", "\\\\").replace('"', '\\"'))
            .replace("__MODES__", ", ".join("." + m for m in modes)).replace("__BODY__", body)
            .replace("__IMPORTS__", "\n".join("import " + m for m in (args.get("--import") or "").split(",") if m.strip())))
    if args.get("--setup"):
        code = args.get("--setup") + "\n" + code
    with open(os.path.join(out, "snippet.swift"), "w") as f:
        f.write(code)

    x_init()
    workspace = os.path.abspath(args.get("--workspace") or find_workspace(path))
    opened = x_text(x_call("XcodeOpenWorkspace", {"path": workspace}, 180))
    ws_id = opened.get("workspaceIdentifier") if isinstance(opened, dict) else None
    if not ws_id:
        raise Fail("headless Xcode did not open %s: %s" % (workspace, str(opened)[:500]), 2)
    project_file = project_path(ws_id, path)
    scheme = args.get("--scheme") or guess_scheme(ws_id, path)
    if scheme:
        cur = x_text(x_call("XcodeListSchemes", {"workspaceIdentifier": ws_id}, 60))
        if isinstance(cur, dict) and cur.get("activeSchemeName") != scheme:
            x_call("XcodeSwitchScheme", {"workspaceIdentifier": ws_id, "schemeName": scheme}, 60)
    timeout = int(args.get("--timeout", "1200"))
    call_args = {"workspaceIdentifier": ws_id, "sourceFilePath": project_file, "codeSnippet": code,
                 "purpose": "Measure the layout of %s with the layout inspector" % label, "timeout": timeout}
    result_path = os.path.join(out, "result.json")
    cmd = [sys.executable, os.path.abspath(__file__), "_xcall", "RunCodeSnippet", json.dumps(call_args),
           "--out", result_path, "--timeout", str(timeout + 60)]
    if not args.flag("--no-queue") and not os.environ.get("PLQ_RUN") and shutil.which("plq"):
        cmd = ["plq", "run", "--label", "li preview " + slug, "--"] + cmd
    t0 = time.time()
    queue_timeout = float(args.get("--queue-timeout", "3600"))
    try:
        p = subprocess.run(cmd, capture_output=True, text=True, timeout=queue_timeout + timeout + 120)
    except subprocess.TimeoutExpired:
        raise Fail("the preview run did not finish in %.0f s (queue wait included; --queue-timeout, --timeout)"
                   % (queue_timeout + timeout + 120), 3)
    took = time.time() - t0
    if p.returncode != 0 or not os.path.exists(result_path):
        code = p.returncode if p.returncode in (1, 2, 3) else 2
        raise Fail("RunCodeSnippet did not finish: %s" % (p.stderr or p.stdout)[-3000:], code)
    raw = json.load(open(result_path))
    body_out = x_text(raw)
    if raw.get("isError"):
        raise Fail("RunCodeSnippet failed: %s" % (json.dumps(body_out) if not isinstance(body_out, str) else body_out)[:4000], 1)
    if isinstance(body_out, dict) and body_out.get("error"):
        err = body_out["error"]
        text = json.dumps(err)[:4000] if not isinstance(err, dict) else "%s\n%s" % (err.get("message"), (err.get("summary") or "")[:3000])
        if "snapshot" in text and ("has no member" in text or "cannot find" in text):
            text += "\nThe module links SwiftUILayoutInspector older than 0.2.6, or does not import it."
        raise Fail("the snippet failed to build or run:\n" + text, 1)
    output = body_out.get("executionResults", "") if isinstance(body_out, dict) else str(body_out)
    info = {}
    for line in output.split("\n"):
        if line.startswith("@@LI@@ "):
            kind, _, rest = line[7:].partition(" ")
            info[kind] = rest
    if "json" in info:
        open(os.path.join(out, "capture.json"), "wb").write(base64.b64decode(info["json"]))
        open(os.path.join(out, "report.txt"), "wb").write(base64.b64decode(info.get("report-b64", "")))
    if not os.path.isfile(os.path.join(out, "capture.json")):
        raise Fail("the snippet ran but wrote nothing to %s. Output:\n%s" % (out, output[-3000:]), 1)
    data = read_json(os.path.join(out, "capture.json")) or {}
    status = read_json(os.path.join(out, "status.json")) or {"library": info.get("version")}
    check_versions(dict(status, schemaVersion=data.get("schemaVersion")))
    stable = info.get("stable", "").split(" ")
    print("preview %s  %d nodes  %d lint issues  %s  (%.0f s)" % (
        label, len([n for n in data.get("nodes", []) if n.get("tree") == "swiftui"]), len(data.get("lint") or []),
        "settled in %.1f s" % float(stable[1]) if stable and stable[0] == "true" else "did NOT settle (captured anyway)",
        took))
    print("out:    %s" % out)
    for name in sorted(os.listdir(out)):
        if name not in ("snippet.swift", "result.json"):
            print("        %s" % name)


def project_path(ws_id, fs_path):
    rel = os.path.abspath(fs_path).split(os.sep)
    res = x_text(x_call("XcodeGlob", {"workspaceIdentifier": ws_id, "pattern": "**/" + rel[-1]}, 60))
    best, best_score = None, -1
    matches = res.get("matches", []) if isinstance(res, dict) else []
    packages = set(res.get("packageDependencies") or []) if isinstance(res, dict) else set()
    # The workspace's own targets first: package checkouts list the same files again.
    own = [m for m in matches if "/Packages/" not in m and m.split("/")[0] not in packages]
    for cand in own or matches:
        parts = cand.split("/")
        score = 0
        while score < min(len(parts), len(rel)) and parts[-1 - score] == rel[-1 - score]:
            score += 1
        if score > best_score:
            best, best_score = cand, score
    if not best:
        raise Fail("%s is not in the workspace (regenerate the project?)" % fs_path, 1)
    return best


def guess_scheme(ws_id, fs_path):
    """The module of the file (the folder above `Sources`) when there is a scheme of that name."""
    parts = os.path.abspath(fs_path).split(os.sep)
    if "Sources" not in parts:
        return None
    module = parts[len(parts) - 1 - parts[::-1].index("Sources") - 1]
    res = x_text(x_call("XcodeListSchemes", {"workspaceIdentifier": ws_id}, 60))
    names = [s.get("name") if isinstance(s, dict) else s for s in (res.get("schemes", []) if isinstance(res, dict) else [])]
    return module if module in names else None


# ---------------------------------------------------------------- main

def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        return 0
    cmd, args = argv[0], Args(argv[1:])
    if cmd in ("version", "--version"):
        print("li %s (report schema %d)" % (LI_VERSION, SCHEMA_VERSION))
        return 0
    if cmd == "mode" and args.pos:
        cmd, args = args.pos[0], Args(argv[2:])
    mode = MODE_ALIASES.get(cmd, cmd)
    if cmd == "measure" and (args.pos or any(k in args.opt for k in ("--text", "--id", "--label", "--type", "--node"))):
        cmd_measure(args)
    elif mode in MODES:
        cmd_mode(args, mode)
    elif cmd in ("off", "refresh", "close", "status"):
        cmd_simple(args, cmd)
    elif cmd == "query":
        cmd_query(args)
    elif cmd == "measure":
        cmd_measure(args)
    elif cmd == "dirs":
        cmd_dirs(args)
    elif cmd == "preview":
        cmd_preview(args)
    elif cmd == "bridge":
        cmd_bridge(args)
    elif cmd == "_xcall":
        cmd_xcall(args)
    else:
        raise Fail("unknown command %s; li --help" % cmd)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except Fail as e:
        print("li: %s" % e, file=sys.stderr)
        sys.exit(e.code)
    except (ValueError, IndexError) as e:
        print("li: bad argument (%s); li --help" % e, file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
